<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SentDm.Voice.Agents</AssemblyName>
    <RootNamespace>SentDm.Voice.Agents</RootNamespace>
    <PackageId>SentDm.Voice.Agents</PackageId>
    <!-- release-please moves this line; the lane stamps the repository's current version at render time. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Sent Voice Agents for .NET: an AI agent that takes and places phone calls through Sent.</Description>
    <PackageTags>sent;voice;agents;calls;websocket</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Members without an XML comment: the generated records document the wire fields that have a description. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SentDm.Voice.Agents.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
